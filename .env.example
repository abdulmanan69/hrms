# WaveTech HRMS — environment
# Copy to .env and change the passwords before real use.

# production turns on stricter logging; keep development for local work
NODE_ENV=production

# ---- Ports ----
WEB_PORT=3000            # the app (nginx); open this one
WEB_BIND=0.0.0.0
API_PORT=8080            # the API, bound to localhost only
API_BIND=127.0.0.1
POSTGRES_PORT=5432       # localhost only, for backups and psql

# ---- Database ----
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=change-me-strong-password

# ---- Sign-in ----
SESSION_TTL_HOURS=12
# false = Secure cookie only when served over HTTPS (detected through the proxy)
COOKIE_SECURE=false

# First company and its super admin, created on the first start only.
# More companies are added in the app (Admin → Companies).
COMPANY_NAME=WaveTech
COMPANY_SLUG=wavetech
ADMIN_EMAIL=admin@wavetech.pk
ADMIN_PASSWORD=ChangeMe123!

# Database connections the API keeps open; each request holds one while it runs
DB_POOL_MAX=10

# Webhooks may only go to public https:// addresses. true also allows plain
# http:// and private addresses (other apps on your LAN or in this Docker network)
WEBHOOK_ALLOW_PRIVATE=false

# Proxies in front of the API whose client-IP header is trusted (sign-in rate
# limit, audit IPs): 1 = the bundled nginx only, 2 = nginx behind Caddy/Coolify
TRUST_PROXY_HOPS=1

# ---- Sample data ----
# true loads two sample companies (WaveTech and Northwind Contact Center) with
# employees, candidates, payroll history and leave, once, into an empty
# database. Keep false for real use.
SEED_DEMO=false

# ---- Files ----
UPLOAD_MAX_MB=10

# ---- Calendar ----
TZ_BUSINESS=Asia/Karachi
